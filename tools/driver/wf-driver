#!/usr/bin/env python3
"""wf-driver launcher. Resolves its own directory onto sys.path so the modules
import flat (``import loop``), then dispatches via driver_main. Invoke as
``python3 .wf/tools/driver/wf-driver [flags]`` (or directly once executable)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from driver_main import main  # noqa: E402

raise SystemExit(main())
