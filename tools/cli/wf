#!/usr/bin/env python3
"""wf CLI launcher. Resolves its own directory onto sys.path so the noun modules
import flat (``import pipeline``), then dispatches via main. Invoke as
``python3 .wf/tools/cli/wf <noun> <verb>`` (or directly once executable)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from main import main  # noqa: E402

raise SystemExit(main())
