# SPRINT — the task DAG the build pipeline executes. TRANSIENT.
#
# Written by wf-swa from the design-slice; gitignored; consumed directly by the
# build pipeline. Not hand-maintained, not committed, not read across changes.
# One inline contract per task; see references/task-contract.md for the field rules.
# Author the THIN fields only — `wf sprint materialize` inlines requirements,
# serves, interface_contract, and the SYS-TC text from the slice.

# sprint-<yyyymmdd>-<short-scope-slug> — filesystem- and branch-name-safe
# ([a-z0-9-] only); names the task worktrees, task branches, and the archive file.
sprint_id: "sprint-<yyyymmdd>-<short-scope-slug>"

sprint:
  summary: "<one line: what this change delivers>"

tasks:
  - id: T1
    title: "<imperative, one line>"
    depends_on: []
    covers: [REQ-1]             # requirements + serves are materialized from the slice
    files_to_touch:             # expected write set — a planning signal, cut with the
                                # impact tool (task-contract.md Scope consistency)
      - "<path>"
      - "<the test file the mandated tests live in>"
    acceptance_criteria:
      - id: REQ-1.AC-1
        check: "<testable statement with named inputs and expected outputs>"
        tests:
          - level: unit                    # unit | integration
            target: "<file>:<function>"    # unit: the target under test
      - id: REQ-1.AC-2
        check: "<failure/boundary behaviour of the same requirement>"
        tests:
          - level: integration
            seam: "<the real external dep or cross-component wiring exercised>"
      # - id: REQ-1.AC-3
      #   check: "<criterion an existing mechanical gate enforces>"
      #   verified_by: "<the gate command>"   # gate-verified: no tests entry
    out_of_scope:
      - "<a cross-slice deferral or adjacent behaviour no mechanism forbids>"
    implementation_notes:
      - "<pointer only: file:line · ADR-NNN + its one-clause constraint · named pattern>"
    # interface_contract_ref: "<contract name>"   # only when the slice's Interface contracts
    #                                             # section fixes this task's shape; materialize
    #                                             # inlines the block verbatim

  # An e2e task — one per SA system test case. depends_on the tasks building the
  # requirements DRIVEN BY the capability the case covers, so it runs the assembled path.
  - id: T2
    title: "System test: <the case's behaviour>"
    depends_on: [T1]            # the tasks building the reqs driven by the case's capability
    covers: []                  # an e2e task proves a SYS-TC, not a component requirement
    files_to_touch:
      - "<the e2e test file>"
    acceptance_criteria: []     # the system test case IS the acceptance; no REQ-N.AC here
    system_tests:
      - id: SYS-TC-1            # description + covers materialized; build stamps [SYS-TC:SYS-TC-1]
    out_of_scope:
      - "Any component logic — the e2e task only exercises the assembled path."
    implementation_notes:
      - "<the e2e home + how it runs — e.g. e2e/ ; establish one if none exists>"
