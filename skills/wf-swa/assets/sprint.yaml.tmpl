# SPRINT — the task DAG the build pipeline executes. TRANSIENT.
#
# Written by wf-swa from the design-slice; gitignored; consumed directly by the
# build pipeline. Not hand-maintained, not committed, not read across changes.
# One inline contract per task; see references/task-contract.md for the field rules.

# sprint-<yyyymmdd>-<short-scope-slug> — filesystem- and branch-name-safe
# ([a-z0-9-] only); names the task worktrees, task branches, and the archive file.
sprint_id: "sprint-<yyyymmdd>-<short-scope-slug>"

sprint:
  summary: "<one line: what this change delivers>"

tasks:
  - id: T1
    title: "<imperative, one line>"
    component: "<component the slice names>"
    depends_on: []
    covers: [REQ-1]
    requirements:               # one entry per id in covers — statement verbatim from the slice
      - id: REQ-1
        statement: "<the requirement's full EARS statement, verbatim>"
        serves: CAP-NNN         # this requirement's driver, read off the slice
    serves: [CAP-NNN]           # the union of the requirements' serves — never just a "primary"
    files_to_touch:
      - "<path>"
      - "<the test file the mandated unit/integration tests live in>"
    acceptance_criteria:
      - id: REQ-1.AC-1
        check: "<testable statement with named inputs and expected outputs>"
      # - id: REQ-1.AC-2
      #   check: "<criterion an existing mechanical gate enforces>"
      #   verified_by: "<the gate command>"   # only when a named gate, not a test, proves it
    testing_mandate:
      unit_tests:
        - target: "<file>:<function>"
          tests:
            - description: "<input> → <expected output> [positive]"
              covers: REQ-1.AC-1
            - description: "<error input> → <expected error> [negative]"
              covers: REQ-1.AC-1
      integration_tests: []     # real seam: external dep OR cross-component wiring; [] + justify if none
      system_tests: []          # [] on a component task — see the e2e task below
    out_of_scope:
      - "<boundary the developer might cross>"
    implementation_notes:
      - "<code pattern from source; ADR-NNN to respect>"
    # interface_contract: |    # only when the task introduces a component / widens a shared
    #   <shape>                # seam — the slice's contract for it, verbatim. Omit otherwise.

  # An e2e task — one per SA system test case. depends_on the tasks building the
  # requirements DRIVEN BY the capability the case covers, so it runs the assembled path.
  - id: T2
    title: "System test: <the case's behaviour>"
    component: "<the e2e test home — e.g. e2e/ ; establish one if none exists>"
    depends_on: [T1]            # the tasks building the reqs driven by CAP-NNN
    covers: []                  # an e2e task proves a SYS-TC (below), not a component requirement
    requirements: []            # empty like covers — the case's text lives in system_tests[].description
    serves: [CAP-NNN]           # the capability the SYS-TC covers
    files_to_touch:
      - "<the e2e test file>"
    acceptance_criteria: []     # the system test case IS the acceptance; no REQ-N.AC here
    testing_mandate:
      unit_tests: []
      integration_tests: []
      system_tests:
        - id: SYS-TC-1          # build stamps [SYS-TC:SYS-TC-1] in the e2e test
          description: "<the SA's end-to-end scenario, over the real path> → <expected>"
          covers: [CAP-NNN]     # the capability the case proves — never a component requirement
    out_of_scope:
      - "Any component logic — the e2e task only exercises the assembled path."
    implementation_notes:
      - "<the SA case verbatim from the slice; the existing e2e home + how it runs>"
