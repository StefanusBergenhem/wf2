# A design issue: the contract is wrong, not the code. Transient, worktree-local. An OPEN
# entry whose task_id matches is the design_issue verdict; dispatch-fix routes it by
# fix_kind. Build only ever raises contract_amendment (routed to the contract-fixer) — it
# does not read or judge the spec layer.
issues:
  - id: "DI-<task-id>"
    task_id: "<id>"
    detected_by: build
    fix_kind: contract_amendment
    severity: "<low | medium | high>"
    status: open
    summary: "<what about the contract is unbuildable — one or two lines>"
