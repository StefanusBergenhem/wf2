# .wf/config.yaml — wf2 project configuration (committed).
#
# Canonical schema source, owned by wf-init. Every field here is read by a skill
# or script — nothing speculative. The config grows one field at a time, as a new
# skill needs it; it never carries a knob no code honors (the governor).
#
# Placeholder values (PROJECT_NAME, TARGET) are substituted by scaffold.sh at init time.

version: 1

project:
  name: "{{PROJECT_NAME}}"
  target: "{{TARGET}}"        # Agent harness(es) this project runs under:
                              # claude | pi | opencode — a single value, or an inline
                              # list (["claude", "pi"]) when several are installed.
                              # install.sh reads it on a flagless re-install and
                              # renders every listed target (a --target flag wins).
  base_branch: "main"         # Branch the orchestrator cuts sprint branches from and
                              # opens the ship PR against.

paths:
  tools: ".wf/tools"          # Installed toolkit machinery (extractors, scripts). Committed.
  transient: ".wf/transient"  # Derived, disposable output root (read-views, plans, handovers).
                              # Gitignored. Never hand-edited.
  discover: ".wf/transient/discover"          # wf-discover working dir (extractor --out; cleared each run).
  # wf-discover output files — each a whole path, so a downstream skill that reads
  # one (e.g. brief) follows a single config edit if it moves.
  discover_model: ".wf/transient/discover/model.json"            # spine output (passed to discover.py --model-out)
  discover_clusters: ".wf/transient/discover/clusters.json"      # cluster output (passed to discover.py --clusters-out)
  discover_subsystems: ".wf/transient/discover/subsystems.json"  # scout output (semantic cache)
  discover_view: ".wf/transient/discover/view.html"              # human interactive map
  discover_brief: ".wf/transient/discover/brief.md"              # agent digest (consumed by planning skills)
  telemetry: ".wf/telemetry/sessions.jsonl"   # Append-only session log. Committed.
  capabilities: ".wf/CAPABILITIES.yaml"       # User-voice capabilities (wf-po appends; wf-sa drains when designed). Committed.

  # Learnings — distilled from telemetry by wf-retrospective. First-class design
  # inputs (peer of capabilities); each entry is one actionable observation.
  learnings: ".wf/LEARNINGS.yaml"             # Project-code learnings (wf-retrospective appends; wf-sa drains when designed). Committed.
  wf_learnings: ".wf/wf-learnings.yaml"       # wf-toolkit friction, for the wf maintainer. Committed.

  # Planning layer (wf-sa, wf-swa). The durable planning artifacts are the ADRs and the
  # design-backlog (committed); the design-slice, drill-cache, and sprint are transient —
  # regenerated per change, consumed by the next role, never hand-maintained.
  adrs: ".wf/adrs"                             # Durable architecture decision records (wf-sa). Committed dir, one .md per ADR.
  design_backlog: ".wf/design-backlog.md"      # wf-sa's designed-but-unbuilt work; drains as reconcile shows it built. Committed.
  design_slice: ".wf/transient/design-slice.md"   # wf-sa cuts this from the backlog for wf-swa; retained through build, drained at complete-sprint. Transient.
  design_view: ".wf/transient/design-view.html"   # wf-sa interactive design diagram (render_design.py). Transient.
  drill_cache: ".wf/transient/drill-cache"        # Shared scout digests (wf-po/wf-sa dispatch wf-drill, which appends; both read). Transient dir.
  sprint: ".wf/transient/sprint.yaml"             # wf-swa task DAG the orchestrator executes. Transient.

  # Maintainer research archive (committed). WRITE-ONLY: the drain sites snapshot each
  # artifact here as it leaves the working set (capabilities/learnings at wf-sa design;
  # slice + sprint + shipped backlog at complete-sprint). NO wf role is ever instructed to
  # read it — it exists solely so the wf2 maintainer can study run quality offline. It is
  # OUTSIDE the governed working set, so the governor's derive-don't-store rule does not
  # apply: nothing consumes it as truth, so it cannot rot.
  archive: ".wf/archive"

  # Orchestration (the build pipeline). pipeline-state is the live run state the brain
  # and the orchestrator read/write on every transition; pipeline-history is its spilled
  # audit tail. Both transient (machine-owned, gitignored) — completion is derived from
  # [REQ] tags, never stored here. complete-sprint snapshots the shipped plan + final state
  # to paths.archive before resetting.
  pipeline_state: ".wf/transient/pipeline-state.yaml"      # live run state: stages, task_states, design_issues, history. Transient.
  pipeline_history: ".wf/transient/pipeline-history.yaml"  # archived history overflow. Transient.

  # Per-task pipeline artifacts — written by the build/review agents inside their task
  # worktree, read by the orchestrator's return-inspection (verdict from on-disk artifact,
  # never from prose). Worktree-local + transient.
  current_task: ".wf/transient/current-task.yaml"      # the extracted task contract the build agent reads.
  review_ready: ".wf/transient/review-ready.yaml"      # build → review handoff (build done, gates green).
  build_blocked: ".wf/transient/build-blocked.yaml"    # build halted: needs a scope amendment.
  feedback: ".wf/transient/feedback.yaml"              # review → build rejection feedback.
  design_issues: ".wf/transient/design-issues.yaml"    # build/review-raised design issues (fix_kind taxonomy → dispatch-fix routing).

parallel:
  max_concurrent_tasks: 4                     # within-stage concurrency cap — independent tasks run in parallel worktrees.
  worktree_base: ".wf/transient/worktrees"    # per-task git worktree root. Transient.

commands:
  preflight: ""        # baseline + per-task gate (lint + tests + build) — set per project; build/review run it, the orchestrator runs it as the worktree baseline.
  stage_check: ""      # heavier checks run only at a stage boundary (e2e / integration) — set per project; empty skips them.

review:
  passes: [wf-review]      # the ordered build→review chain per task; append e.g. wf-security-review to extend it (no skill change).
  max_attempts: 3          # build→review cycles per task before escalation.
  max_scope_amendments: 1  # feature scope amendments allowed per task.

closeout: [wf-retrospective, ship]   # ordered end-of-sprint steps; a wf-* entry is dispatched as an agent, `ship` is the terminal publish. Extend with e.g. wf-update-docs.

orchestrate:
  history_cap: 50          # live pipeline-state history entries kept; older spill to pipeline_history.

id_counters:            # high-water marks for draining id lanes — only ever increase.
  cap: 0                # CAP-NNN (wf-po bumps)
  learning: 0           # L-NNN in paths.learnings (wf-retrospective bumps)
  wf_learning: 0        # L-NNN in paths.wf_learnings (wf-retrospective bumps)

telemetry:
  enabled: true               # When false, skills skip the end-of-session record step.
