# SPRINT — the sprint's task DAG, executed by the driver. TRANSIENT.
#
# Written by wf-tl when its increment's turn comes, and APPENDED to by each later
# increment's run; gitignored; consumed directly by the build pipeline. Not
# hand-maintained, not committed. One inline contract per task; see
# references/task-contract.md for the field rules. Author the fields below only —
# `wf sprint materialize` inlines each `system_tests` entry's SYS-TC scenario text.

tasks:
  - id: T1
    increment: 2
    depends_on: []
    covers: [CAP-NNN]           # and/or L-NNN — the driver this task serves
    story: |
      <2–4 paragraphs: what this task builds and why; how the change flows through the
       code; what is new against what already exists.>
    acceptance:
      - id: AC-1
        criterion: "<trigger → observable response, one behaviour>"
        tests:
          - {level: unit, target: "<file>:<function>"}
      - id: AC-2
        criterion: "<a failure or boundary behaviour of the same change>"
        tests:
          - {level: integration, seam: "<the real external dep or wiring exercised>", target: "<TestName>"}
      # - id: AC-3
      #   criterion: "<a fact only a gate can observe — name the source fact here>"
      #   verified_by: inspection
    boundaries: |
      <out of scope · read-only files · fixed interfaces. Binding on the build.>
    grounding:
      - "<path>:<line> — <what is there>"
      - "ADR-NNN — <the one-clause constraint, verbatim from its constraint: line>"

  # An e2e task — one per SYS-TC case this increment completes.
  - id: T2
    increment: 2
    title: "System test: <the case's behaviour>"
    depends_on: [T1]            # the tasks that assemble the path the case exercises
    covers: [CAP-NNN]
    story: |
      <what end-to-end behaviour this proves and which assembled path it runs.>
    acceptance: []              # the system test case IS the acceptance
    system_tests: [SYS-TC-NNN]  # scenario text materialized; build stamps [SYS-TC:SYS-TC-NNN]
    boundaries: |
      Any component logic — this task only exercises the assembled path.
    grounding:
      - "<the e2e home + how it runs — e.g. e2e/ ; establish one if none exists>"
